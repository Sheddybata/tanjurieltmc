# ─── Local development ───────────────────────────────────────────────────────
# Transaction pooler (6543) is fine for the running API; migrations need DIRECT_DATABASE_URL.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Session pooler (5432) or direct connection — used by Prisma migrate / db push
DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ─── Railway / production ────────────────────────────────────────────────────
# Option A (recommended): direct Postgres (does not share the 15-session pooler cap)
#   DATABASE_URL=postgresql://postgres.[REF]:[PASS]@db.[REF].supabase.co:5432/postgres?sslmode=require
#   DIRECT_DATABASE_URL=<same>
#
# Option B: Supabase pooler — must cap Prisma connections (startup script adds connection_limit=1)
#   Transaction pooler: ...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   Session pooler:     ...pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=1
#   DIRECT_DATABASE_URL = direct db.[REF].supabase.co:5432 URL (for migrations only)
#
# Variable names must be UPPERCASE on Railway.

# API
API_PORT=4000
JWT_SECRET=change-me-in-production-use-256-bit-secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Optional — production web origins (comma-separated for API CORS)
# CORS_ORIGIN=https://tanjurieltmc.com,https://www.tanjurieltmc.com,https://admin.tanjurieltmc.com

# ─── Domains (tanjurieltmc.com) ──────────────────────────────────────────────
# Public website:  https://tanjurieltmc.com
# Staff portal:    https://admin.tanjurieltmc.com  (same Next.js app, routed by middleware)
# Point both DNS records at your hosting provider (e.g. Railway, Vercel, Cloudflare).
#
# Web app (apps/web/.env.local or hosting env vars):
# NEXT_PUBLIC_SITE_URL=https://tanjurieltmc.com
# NEXT_PUBLIC_ADMIN_URL=https://admin.tanjurieltmc.com
# NEXT_PUBLIC_PUBLIC_HOST=tanjurieltmc.com
# NEXT_PUBLIC_ADMIN_HOST=admin.tanjurieltmc.com
# NEXT_PUBLIC_API_URL=https://api.tanjurieltmc.com

# ─── Wema ALAT Merchant Payout (banks, name enquiry, outbound transfers) ─────
# Subscribe at https://wema-alatdev-apimgt.developer.azure-api.net/merchant-payout
ALAT_ENABLED=false
ALAT_BASE_URL=https://your-alat-sandbox-base-url
ALAT_SUBSCRIPTION_KEY=your-primary-key-from-alat-portal
# Header name from API reference (Azure API Management default below)
ALAT_SUBSCRIPTION_HEADER=Ocp-Apim-Subscription-Key
# From Wema liaison after merchant onboarding
ALAT_VENDOR_ID=
ALAT_USERNAME=
ALAT_PASSWORD=
# Sandbox encryption (production keys issued separately)
ALAT_ENCRYPTION_KEY=")KCSWITHC%^$$%@H"
ALAT_ENCRYPTION_IV="#$%#^%KCSWITC945"
# Settlement account debited for NIP outbound (when transfers are automated)
ALAT_SOURCE_ACCOUNT=

# Transfer fee shown in mobile app (NGN)
TRANSFER_FEE=25

# ─── Web app — direct mobile downloads (until Play Store / App Store) ────────
# Place builds in apps/web/public/downloads/ or host elsewhere and set full URLs.
# NEXT_PUBLIC_ANDROID_APP_URL=/downloads/tanjuriel-android.apk
# NEXT_PUBLIC_IOS_APP_URL=/downloads/tanjuriel-ios.ipa
