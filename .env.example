# Database (Supabase: Project Settings → Database → URI → Direct connection)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# API
API_PORT=4000
JWT_SECRET=change-me-in-production-use-256-bit-secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Optional — only needed when deploying (defaults to localhost:3000)
# CORS_ORIGIN=https://admin.yourdomain.com
