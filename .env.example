# Database (Supabase: Project Settings → Database → Connection string → Session pooler, port 5432)
# Use UPPERCASE DATABASE_URL in Railway — lowercase database_url will not work.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# API
API_PORT=4000
JWT_SECRET=change-me-in-production-use-256-bit-secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Optional — only needed when deploying (defaults to localhost:3000)
# CORS_ORIGIN=https://admin.yourdomain.com
