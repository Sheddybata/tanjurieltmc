{
  "name": "tanjuriel-microfinance",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise microfinance admin & teller platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=@tanjuriel/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "npm run generate --workspace=@tanjuriel/database",
    "db:migrate": "npm run migrate --workspace=@tanjuriel/database",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@tanjuriel/database",
    "db:push": "npm run push --workspace=@tanjuriel/database",
    "db:seed": "npm run seed --workspace=@tanjuriel/database",
    "db:studio": "npm run studio --workspace=@tanjuriel/database",
    "build:api": "npm run build --workspace=@tanjuriel/database && npm run build --workspace=@tanjuriel/api",
    "start:api": "node apps/api/dist/main.js"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.6.1"
}
